{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "ReverseProxy": {
        "Routes": {
            "topup-route": {
                "ClusterId": "topup-cluster",
                "Match": {
                    "Path": "/api/topup/{**catch-all}"
                }
            }
        },

        "Clusters": {
            "topup-cluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7001/"
                    }
                }
            }
        }
    }
}
