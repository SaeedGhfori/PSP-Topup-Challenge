{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },

    "ReverseProxy": {
        "Routes": {
            "payment": {
                "ClusterId": "payment",
                "Match": {
                    "Path": "/payment/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "payment": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7061/"
                    }
                }
            }
        }
    }
}
